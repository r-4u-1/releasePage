// The form page's scripts: client/*.ts, compiled to public/*.js for the browser.
// They're plain <script> files, not modules, so index.html loads them as they are.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "rootDir": ".",
    "outDir": "../public",
    "tsBuildInfoFile": "../server/dist/client.tsbuildinfo"
  },
  "include": ["*.ts"]
}
