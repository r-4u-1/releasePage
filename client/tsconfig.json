// Not needed to run anything: the server sends client/*.ts to the browser as /*.js, with the types removed.
// They're plain <script> files, not modules, so index.html loads them as they are.
// This tells the editor how to check them.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
