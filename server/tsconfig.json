// Node runs the .ts files as they are: it only strips the types, it never checks them.
// "npm run check" checks them with TypeScript; nothing is compiled.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true, // Node needs "./lib/git.ts", not "./lib/git"
    "erasableSyntaxOnly": true,         // only TypeScript that Node can strip, e.g. no enum
    "verbatimModuleSyntax": true        // type-only imports must say "import type"
  },
  "include": ["server.ts", "lib"]
}
