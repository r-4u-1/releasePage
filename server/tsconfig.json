// Not needed to run anything: Node runs server.ts as it is and only removes the types.
// This tells the editor how to check the server's TypeScript.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["server.ts", "lib"]
}
